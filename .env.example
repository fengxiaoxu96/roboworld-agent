# ==============================================================================
# RoboWorld Agent Environment Variables Configuration Template (.env)
# Copy this file to .env and configure as needed to take effect
# ==============================================================================

# ==============================================================================
# 1. Large Language Model (LLM) Operating Mode Overview (Dual-Scenario Adaptation)
# ==============================================================================
# [Scenario A: Cloud Deployment / GitHub Actions Pipeline / Key-Free Pure Offline]
# Keep LLM_ENABLED=false below (or leave blank), and the system will run 100% on the local heuristic rule engine:
#   - 0 API Token consumption, 0 external network dependencies, 0 failure risk, ultra-fast execution;
#   - Ready out of the box with zero configuration in GitHub Actions CI/CD and Streamlit Community Cloud deployments.
#
# [Scenario B: Local In-Depth Analysis and RAG Q&A]
# Set LLM_ENABLED=true below, and configure the API Key and endpoint below:
#   - If properly configured with a valid Key (and the Key format, provider, and endpoint URL match): activate corresponding commercial cloud models or local Ollama models;
#   - If improperly configured, format mismatched, or facing network fluctuations: the system automatically and smoothly downgrades to the heuristic rule engine, ensuring the workflow never interrupts or crashes.

# ==============================================================================
# 2. General Large Language Model (LLM) Configuration Template (Identical format to provider examples below, can be copied and replaced as a block)
# ==============================================================================
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Quick Configuration Examples for Common Providers (Copy a block to overwrite the general configuration above for quick switching in local use):
# ------------------------------------------------------------------------------
# [Example A: OpenAI (Official Standard API)]
# LLM_ENABLED=true
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-your-openai-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# [Example B: DeepSeek (Cost-Effective Recommendation)]
# LLM_ENABLED=true
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-deepseek-api-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# [Example C: Google Gemini (Official OpenAI-Compatible Endpoint)]
# LLM_ENABLED=true
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSyYourGeminiApiKeyHere...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# [Example D: Alibaba Qwen (DashScope Compatible Mode)]
# LLM_ENABLED=true
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-your-dashscope-api-key-here
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# [Example E: Local Ollama (Completely Offline and Free, No Real API Key Needed)]
# LLM_ENABLED=true
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# [Example F: SiliconFlow]
# LLM_ENABLED=true
# LLM_PROVIDER=siliconflow
# LLM_API_KEY=sk-your-siliconflow-api-key-here
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# ==============================================================================
# 3. Observability & Tracing (LangSmith, Optional)
# ==============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=roboworld-agent
# LangSmith endpoint URL (Defaults to official cloud; use https://eu.api.smith.langchain.com for EU region)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==============================================================================
# 4. Local Storage Backend Path Configuration
# ==============================================================================
SQLITE_DB_PATH=data/papers.db
QDRANT_STORAGE_PATH=data/qdrant_storage

# ============================================================================
# 5. Scheduling & Notification Push
# ============================================================================
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
# CRON_SCHEDULE=0 8 * * *

