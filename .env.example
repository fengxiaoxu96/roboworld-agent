# ==============================================================================
# RoboWorld Agent 环境变量配置文件模板 (.env)
# 复制此文件为 .env 并按需配置即可生效
# ==============================================================================

# ==============================================================================
# 1. 大语言模型 (LLM) 运行模式总说明 (双场景模式适配)
# ==============================================================================
# 【场景 A：云端部署 / GitHub Actions 流水线 / 免 Key 纯离线】
# 保持下方 LLM_ENABLED=false（或留空不填），系统将 100% 运行于本地启发式规则引擎：
#   - 0 API Token 消耗、0 网络外部依赖、0 故障风险、极速运行；
#   - 在 GitHub Actions CI/CD 与 Streamlit Community Cloud 在线部署中零配置开箱即用。
#
# 【场景 B：本地深度研判与 RAG 问答】
# 设置下方 LLM_ENABLED=true，并配置下方的 API Key 与端点：
#   - 若正常配置有效 Key（且 Key 格式、供应商与端点 URL 匹配）：激活对应商业云端模型或本地 Ollama 模型；
#   - 若未正常配置、格式不匹配或网络波动：系统自动平滑降级为启发式规则引擎，保障全流程绝不中断崩溃。

# ==============================================================================
# 2. 通用大语言模型 (LLM) 通用配置模板 (与下方服务商示例完全一致，可整块复制替换)
# ==============================================================================
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 常用服务商快速配置示例（本地使用时复制整块覆盖上方通用配置即可快速切换）：
# ------------------------------------------------------------------------------
# 【示例 A：OpenAI (官方标准接口)】
# LLM_ENABLED=true
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-your-openai-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# 【示例 B：DeepSeek (高性价比推荐)】
# LLM_ENABLED=true
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-deepseek-api-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# 【示例 C：Google Gemini (官方 OpenAI 兼容端点)】
# LLM_ENABLED=true
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSyYourGeminiApiKeyHere...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# 【示例 D：阿里通义千问 (DashScope 兼容模式)】
# LLM_ENABLED=true
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-your-dashscope-api-key-here
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# 【示例 E：本地 Ollama (完全离线与免费，无需真实 API Key)】
# LLM_ENABLED=true
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# 【示例 F：硅基流动 SiliconFlow】
# LLM_ENABLED=true
# LLM_PROVIDER=siliconflow
# LLM_API_KEY=sk-your-siliconflow-api-key-here
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0
# LLM_MAX_RETRIES=2

# ==============================================================================
# 3. 可观测性追踪（LangSmith，可选）
# ==============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=roboworld-agent

# ==============================================================================
# 4. 本地存储底座路径配置
# ==============================================================================
SQLITE_DB_PATH=data/papers.db
QDRANT_STORAGE_PATH=data/qdrant_storage
